  doi = {10.48550/arXiv.2601.11740},
  url = {http://arxiv.org/abs/2601.11740},
  urldate = {2026-05-20},
  abstract = {Complete analytic solutions to quasi-continuous-wave four-wave mixing in nonlinear optical fibres are presented in terms of Weierstrass elliptic \$\textbackslash wp\$, \$ζ\$, and \$σ\$ functions, providing the full complex envelopes for all four waves under arbitrary initial conditions. A sequence of coordinate transformations reveals a canonical form with universal parameter-free structure. Remarkably, these transformations depend explicitly on the propagation variable yet preserve the structural form of the differential equations, an invariance property not previously reported for four-wave mixing. In the canonical coordinates, solutions become single-valued meromorphic Kronecker theta functions, establishing connections with other integrable nonlinear optical systems. The Hamiltonian conservation is shown to arise from the Frobenius-Stickelberger determinant. Numerical validation confirms the solutions using open-source Python libraries.},
  pubstate = {prepublished},
  keywords = {Nonlinear Sciences - Exactly Solvable and Integrable Systems},
  file = {/Users/grahamhesketh/Zotero/storage/MPTBJWDL/Hesketh - 2026 - Complete Weierstrass elliptic function solutions and canonical coordinates for four-wave mixing in n.pdf;/Users/grahamhesketh/Zotero/storage/NPXIZYPZ/2601.html}
