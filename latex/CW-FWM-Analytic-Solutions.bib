@online{zotero-item-855,
  title = {Hyperelliptic Sigma Solutions of Polynomial {{Hamiltonian}} Systems},
  author = {Hesketh, Graham},
  date = {2026},
  url = {https://arxiv.org/abs/2610.22784},
  abstract = {We study polynomial Hamiltonian systems whose Hamiltonians consist of two weighted products of canonical modes minus a polynomial in their powers. This class extends the structure of familiar genus-one coupled-mode systems from nonlinear optics. We construct local analytic solutions in terms of sigma functions and Abelian integrals on smooth odd-degree hyperelliptic curves, subject to stated degree and regularity conditions. We associate Onishi's determinant identities with the conservation-law structure of these systems, extending the connection previously identified between Frobenius-Stickelberger determinants and conserved quantities in genus-one nonlinear optics. Explicit genus-two and genus-three examples include bounded oscillatory scalar motion. We evaluate the solutions using Generapy, a purpose-built Python package for algebraic curves and Abelian functions, and validate them against independent fourth-order Runge-Kutta integration.},
  pubstate = {prepublished},
  keywords = {Nonlinear Sciences - Exactly Solvable and Integrable Systems},
  file = {/Users/grahamhesketh/Zotero/storage/QCYRXEXA/Hesketh - 2026 - Hyperelliptic sigma solutions of polynomial Hamiltonian systems.pdf;/Users/grahamhesketh/Zotero/storage/ES4J3M6X/2610.html}
